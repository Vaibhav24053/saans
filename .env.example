# Gemini Developer API Key (free tier available at https://aistudio.google.com/apikey)
# Keep this strictly server-side. Never prefix with VITE_. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: production server port (defaults to 3001)
PORT=3001

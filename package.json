{
  "name": "saans-air-companion",
  "private": true,
  "version": "1.0.0",
  "description": "SAANS — Know the air. Change your day. GenAI-powered personal and family urban air quality companion.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
